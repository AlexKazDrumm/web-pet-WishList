# Normalise line endings: the repository is LF-only, checkouts included.
* text=auto eol=lf

*.sh        text eol=lf
Dockerfile  text eol=lf
*.Dockerfile text eol=lf

# Binary assets — never touched by EOL conversion or diffed as text.
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary
