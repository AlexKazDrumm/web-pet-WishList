# Copy to .env and set the values.

# PostgreSQL
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/wishlist
POSTGRES_USER=wishlist
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wishlist
DB_PORT=5433

# Backend
NODE_ENV=development
PORT=3031
# false, true or proxy hop count
TRUST_PROXY=false
CORS_ORIGINS=http://localhost:3000
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
UPLOAD_DIR=./var/uploads
MAX_UPLOAD_BYTES=5242880
LOG_LEVEL=info
RUN_SEED=false

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:3031
