# Copy to .env and fill in real values. .env is git-ignored.

# ─── Database ────────────────────────────────────────────────────────────────
# Connection string used by the backend. Docker Compose sets its own.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/wishlist
# Used only by docker-compose to initialise the bundled database service:
POSTGRES_USER=wishlist
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wishlist
# Host port the bundled db service is published on (container port stays 5432):
DB_PORT=5433

# ─── Backend ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3031
# Comma-separated list of exact allowed browser origins (no wildcards).
CORS_ORIGINS=http://localhost:3000
# Secrets: required in production, no defaults. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
# Absolute or relative path where uploaded media is stored (kept out of git).
UPLOAD_DIR=./apps/backend/var/uploads
MAX_UPLOAD_BYTES=5242880
LOG_LEVEL=info
# Set to true to run the seed when the backend container starts:
RUN_SEED=false

# ─── Frontend ───────────────────────────────────────────────────────────────
# Public base URL of the backend API, as reachable from the browser.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3031
